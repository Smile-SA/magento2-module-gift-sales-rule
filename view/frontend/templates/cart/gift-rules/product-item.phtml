<?php

/** @var \Smile\GiftSalesRule\Block\Cart\GiftRules\ProductItem $block */
/** @var \Magento\Framework\Escaper $escaper */
$product = $block->getProduct();
$selectedQty = $block->getProductQty();
?>
<li class="item product product-item">
    <div class="product-item-info freegift-product-item<?php if ($selectedQty): ?> active<?php endif; ?>">
        <span class="product photo product-item-photo">
            <?= /* @noEscape */ $block->getImage($product, 'category_page_grid')->toHtml() ?>
        </span>
        <div class="product details product-item-details" data-product-id="<?= (int) $product->getId() ?>">
            <strong class="product name product-item-name"><?= $escaper->escapeHtml($product->getName()) ?></strong>
            <?= /* @noEscape */ $block->getProductDetailsHtml($product) ?>
            <div class="field qty">
                <label class="label" for="qty-<?= (int) $product->getId() ?>">
                    <span><?= $escaper->escapeHtml(__('Qty')) ?></span>
                </label>
                <div class="control">
                    <input type="number"
                           name="products[<?= (int) $product->getId() ?>][qty]"
                           id="qty-<?= (int) $product->getId() ?>"
                           title="<?= $escaper->escapeHtmlAttr(__('Qty')) ?>"
                           class="input-text qty"
                           <?php if ($selectedQty): ?>value="<?= (int) $selectedQty ?>"<?php endif; ?>
                    />
                </div>
            </div>
        </div>
    </div>
</li>
