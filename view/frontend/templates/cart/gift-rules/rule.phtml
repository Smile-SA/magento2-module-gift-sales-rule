/** @var $block \Smile\GiftSalesRule\Block\Cart\GiftRules\Rule */
/** @var $giftRuleViewModel \Smile\GiftSalesRule\ViewModel\GiftRule */
$giftRuleViewModel = $block->getData('giftRuleViewModel');
$rule = $block->getGiftRule();
?>

<?php if ($rule) : ?>
    <div class="rule-item">
        <span class="name"><?= $escaper->escapeHtml($rule->getLabel()) ?></span>
        <button class="choose action primary" type="button"
                data-trigger="rule-freegift-popin-<?= (int) $rule->getRuleId() ?>"><?= $escaper->escapeHtml($block->getButtonLabel()) ?></button>
        <div class="popin-block" id="rule-freegift-popin-<?= (int) $rule->getRuleId() ?>" data-mage-init='{
            "Magento_Ui/js/modal/modal": {
                "type": "popup",
                "trigger": "[data-trigger=rule-freegift-popin-<?= (int) $rule->getRuleId() ?>]",
                <?php if ($giftRuleViewModel->isAutomaticPopupOpenEnabled()): ?>
                "autoOpen": <?= $rule->getRestNumber() ? 'true' : 'false'; ?>,
                <?php endif; ?>
                "responsive": true,
                "modalClass": "free-gift-modal",
                "innerScroll": true,
                "title": "<?= $escaper->escapeJs(__('%1: choose your %2 gifts', $rule->getLabel(), $rule->getNumberOfferedProduct())) ?>",
                "buttons": []
            }
        }'  style="display: none;">
            <div id="choose-gifts" data-mage-init='{"smileChooseGifts":{
                "nbProductToOffer": "<?= (int) $rule->getNumberOfferedProduct() ?>",
                "formId": "#choose-gifts-form-<?= (int) $rule->getCode() ?>"
            }}'>
                <form id="choose-gifts-form-<?= (int) $rule->getCode() ?>" method="post" action="<?= $escaper->escapeUrl($block->getAddToCartUrl($rule->getRuleId(), $rule->getCode())) ?>">
                    <div class="messages">
                        <div class="message-error error message">
                            <div class="message-text"></div>
                        </div>
                    </div>
                    <div class="products-grid">
                        <ul class="freegift products list items product-items">
                            <?php
                            /** @var \Smile\GiftSalesRule\Block\Cart\GiftRules\ProductItem $childBlock */
                            $childBlock = $block->getChildBlock('checkout.cart.gift-rules.product-item');
                            ?>
                            <?php foreach ($block->getProductCollection($rule->getProductItems())->getItems() as $product) : ?>
                                <?= $childBlock->setProduct($product)->setGiftRule($rule)->toHtml(); ?>
                            <?php endforeach; ?>
                        </ul>
                    </div>
                    <div class="actions">
                        <div class="primary-block">
                            <button class="action primary validate-choose-gifts" type="submit" title="<?= $escaper->escapeHtmlAttr(__('Validate my gift(s)')) ?>">
                                <?= $escaper->escapeHtml(__('Validate my gift(s)')) ?>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
<?php endif; ?>
