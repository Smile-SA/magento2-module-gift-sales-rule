<?php

/** @var \Smile\GiftSalesRule\Block\Cart\GiftRules\Rule $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Smile\GiftSalesRule\ViewModel\GiftRule $giftRuleViewModel */
$giftRuleViewModel = $block->getData('giftRuleViewModel');
$rule = $block->getGiftRule();
?>

<?php if ($rule): ?>
    <?php $ruleCode = $escaper->escapeHtmlAttr($rule->getCode()); ?>
    <?php $addToCartUrl = $block->getAddToCartUrl($rule->getRuleId(), $rule->getCode()); ?>
    <div class="rule-item">
        <span class="name"><?= $escaper->escapeHtml($rule->getLabel()) ?></span>
        <button class="choose action primary"
                onclick="jQuery('#rule-freegift-popin-<?= /* @noEscape */ $ruleCode ?>').modal('openModal')">
            <?= $escaper->escapeHtml($block->getButtonLabel()) ?>
        </button>
        <div class="popin-block" id="rule-freegift-popin-<?= /* @noEscape */ $ruleCode ?>" data-mage-init='{
            "Magento_Ui/js/modal/modal": {
                "type": "popup",
                <?php if ($giftRuleViewModel->isAutomaticPopupOpenEnabled()): ?>
                "autoOpen": <?= $rule->getRestNumber() ? 'true' : 'false'; ?>,
                <?php endif; ?>
                "responsive": true,
                "modalClass": "free-gift-modal",
                "innerScroll": true,
                "title": "<?= $escaper->escapeJs(__(
                    '%1: choose your %2 gifts',
                    $rule->getLabel(),
                    $rule->getNumberOfferedProduct()
                )) ?>",
                "buttons": []
            }
        }'  style="display: none;">
            <div id="choose-gifts" data-mage-init='{"smileChooseGifts":{
                "nbProductToOffer": "<?= (int) $rule->getNumberOfferedProduct() ?>",
                "formId": "#choose-gifts-form-<?= (int) $rule->getCode() ?>"
            }}'>
                <form id="choose-gifts-form-<?= (int) $rule->getCode() ?>" method="post"
                      action="<?= $escaper->escapeUrl($addToCartUrl) ?>">
                    <div class="messages">
                        <div class="message-error error message">
                            <div class="message-text"></div>
                        </div>
                    </div>
                    <div class="products-grid">
                        <ul class="freegift products list items product-items">
                            <?php
                            /** @var \Smile\GiftSalesRule\Block\Cart\GiftRules\ProductItem $childBlock */
                            $childBlock = $block->getChildBlock('checkout.cart.gift-rules.product-item');
                            ?>
                            <?php $products = $block->getProductCollection($rule->getProductItems())->getItems(); ?>
                            <?php foreach ($products as $product): ?>
                                <?= /* @noEscape */ $childBlock->setProduct($product)->setGiftRule($rule)->toHtml() ?>
                            <?php endforeach; ?>
                        </ul>
                    </div>
                    <div class="actions">
                        <div class="primary-block">
                            <button class="action primary validate-choose-gifts" type="submit"
                                    title="<?= $escaper->escapeHtmlAttr(__('Validate my gift(s)')) ?>">
                                <?= $escaper->escapeHtml(__('Validate my gift(s)')) ?>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
<?php endif; ?>
