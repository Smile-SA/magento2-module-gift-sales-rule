<?php

/** @var \Magento\ConfigurableProduct\Block\Product\View\Type\Configurable $block */
/** @var \Magento\Framework\Escaper $escaper */
$_product    = $block->getProduct();
$_productId  = (int) $_product->getId();
$_attributes = $block->decorateArray($block->getAllowAttributes());
$_galleryStrategy = $block->getVar('gallery_switch_strategy', 'Magento_ConfigurableProduct') ?: 'replace';
?>
<?php if ($_product->isSaleable() && count($_attributes)):?>
    <div id="configurable-attributes-<?= (int) $_productId ?>" class="configurable-attributes">
        <input name="products[<?= (int) $_productId ?>][selected_configurable_option]" type="hidden" value="" />
        <?php foreach ($_attributes as $_attribute): ?>
            <?php $_attributeId = (int) $_attribute->getAttributeId(); ?>
            <?php $_selectName = 'products[' . $_productId . '][super_attribute][' . $_attributeId . ']'; ?>
            <div class="field configurable required">
                <label class="label" for="products[<?= (int) $_productId ?>]attribute<?= (int) $_attributeId ?>">
                    <span><?= $escaper->escapeHtml($_attribute->getProductAttribute()->getStoreLabel()) ?></span>
                </label>
                <div class="control">
                    <select name="<?= /* @noEscape */ $_selectName ?>"
                            data-selector="<?= /* @noEscape */ $_selectName ?>"
                            data-validate="{required:true}"
                            id="products[<?= (int) $_productId ?>]attribute<?= (int) $_attributeId ?>"
                            data-attribute-id="<?= (int) $_attributeId ?>"
                            class="super-attribute-select super-attribute-select-<?= (int) $_productId ?>">
                        <option value=""><?= $escaper->escapeHtml(__('Choose an Option...')) ?></option>
                    </select>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
    <script type="text/x-magento-init">
        {
            "#configurable-attributes-<?= (int) $_productId ?>": {
                "Smile_GiftSalesRule/js/configurable": {
                    "superSelector": ".super-attribute-select-<?= (int) $_productId ?>",
                    "selectSimpleProduct": "[name='products[<?= (int) $_productId ?>][selected_configurable_option]']",
                    "spConfig": <?= /* @noEscape */ $block->getJsonConfig() ?>,
                    "gallerySwitchStrategy": "<?= $escaper->escapeJs($_galleryStrategy) ?>"
                }
            }
        }
    </script>
<?php endif;?>
