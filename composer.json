{
    "name": "smile/module-gift-sales-rule",
    "type": "magento2-module",
    "description": "Extension of Magento2 Sales Rule to provide gifted (free) products.",
    "keywords": ["magento2", "salesrule", "gift", "cart", "free"],
    "license": "OSL-3.0",
    "require": {
        "php": "^8.1",
        "magento/framework": ">=103.0.4 <103.0.6",
        "magento/module-configurable-product": "^100.4.0",
        "magento/module-sales-rule": "^101.2.4",
        "magento/module-swatches": "^100.4.0",
        "magento/module-weee": "^100.4.0"
    },
    "require-dev": {
        "smile/magento2-smilelab-quality-suite": "^4.0"
    },
    "authors":[
        {
            "name": "Maxime Queneau",
            "email": "maxime.queneau@smile.fr",
            "homepage": "https://www.smile.eu/",
            "role": "Developer"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Smile\\GiftSalesRule\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    }
}
